---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout title="404 — Recipe Not Found | The Cozy Skillet">
  <div class="max-w-xl mx-auto px-4 py-20 text-center">
    <div class="flex justify-center mb-6">
      <Logo size="xl" showWordmark={false} />
    </div>
    <span class="text-xs font-bold uppercase tracking-wider text-[#9C4B25] bg-[#FAF3EE] px-3 py-1 rounded-xl">
      Error 404
    </span>
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#4A3F35] mt-4 mb-3">
      This skillet is clean!
    </h1>
    <p class="text-sm sm:text-base text-[#5F5045] leading-relaxed mb-8">
      We couldn't find the recipe or page you were looking for. It might have been moved or eaten!
    </p>

    <div class="flex items-center justify-center gap-3">
      <a 
        href="/" 
        class="px-5 py-3 bg-[#9C4B25] hover:bg-[#7A3617] text-white text-sm font-bold rounded-2xl shadow-sm transition-all"
      >
        Back to Recipes
      </a>
      <a 
        href="/search" 
        class="px-5 py-3 bg-white hover:bg-[#FAF3EE] border border-[#EBE5D9] text-[#4A3F35] text-sm font-bold rounded-2xl shadow-2xs transition-all"
      >
        Search by Ingredient
      </a>
    </div>
  </div>
</Layout>
