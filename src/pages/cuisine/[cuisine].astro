---
import Layout from '../../layouts/Layout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getCollection } from 'astro:content';
import { CUISINES } from '../../data/categories';

export async function getStaticPaths() {
  const allRecipes = await getCollection('recipes');

  return CUISINES.map((cuisine) => {
    const matchingRecipes = allRecipes.filter((r) =>
      r.data.cuisine.some((c: string) => c.toLowerCase() === cuisine.name.toLowerCase())
    );

    return {
      params: { cuisine: cuisine.slug },
      props: {
        cuisineMeta: cuisine,
        recipes: matchingRecipes,
      },
    };
  });
}

const { cuisineMeta, recipes } = Astro.props;
---

<Layout title={`${cuisineMeta.name} Recipes | The Cozy Skillet`} description={cuisineMeta.description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#6B5B4F] mb-6">
      <a href="/" class="hover:text-[#9C4B25] transition-colors">Home</a>
      <span>/</span>
      <a href="/categories" class="hover:text-[#9C4B25] transition-colors">Cuisines</a>
      <span>/</span>
      <span class="text-[#4A3F35] font-semibold">{cuisineMeta.name}</span>
    </nav>

    <!-- Cuisine Header -->
    <div class="mb-12 max-w-2xl">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl sm:text-4xl">{cuisineMeta.emoji}</span>
        <h1 class="text-3xl sm:text-5xl font-serif font-bold text-[#4A3F35]">
          {cuisineMeta.name} Inspired
        </h1>
      </div>
      <p class="text-base sm:text-lg text-[#5F5045] leading-relaxed">
        {cuisineMeta.description}
      </p>
      <div class="text-xs font-semibold text-[#9C4B25] mt-3">
        {recipes.length} {recipes.length === 1 ? 'tested recipe' : 'tested recipes'}
      </div>
    </div>

    <!-- Recipe Grid -->
    {recipes.length > 0 ? (
      <div>
        <h2 class="sr-only">{cuisineMeta.name} Skillet Recipes</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {recipes.map((recipe, index) => (
            <RecipeCard
              slug={recipe.id.replace(/\.(md|mdx)$/, '')}
              title={recipe.data.title}
              description={recipe.data.description}
              categories={recipe.data.categories}
              cuisine={recipe.data.cuisine}
              tags={recipe.data.tags}
              dietary={recipe.data.dietary}
              difficulty={recipe.data.difficulty}
              prepTimeMinutes={recipe.data.prepTimeMinutes}
              cookTimeMinutes={recipe.data.cookTimeMinutes}
              proofTimeMinutes={recipe.data.proofTimeMinutes}
              hydration={recipe.data.hydration}
              servings={recipe.data.servings}
              bakingType={recipe.data.bakingType}
              image={recipe.data.image}
              imageAlt={recipe.data.imageAlt}
              priority={index < 3}
            />
          ))}
        </div>
      </div>
    ) : (
      <div class="p-12 text-center bg-white border border-[#EBE5D9] rounded-3xl">
        <div class="text-4xl mb-3">🥘</div>
        <h3 class="text-lg font-serif font-bold text-[#4A3F35]">Recipes coming soon!</h3>
        <p class="text-xs text-[#6B5B4F] mt-1 mb-4">We are actively developing recipes for {cuisineMeta.name}.</p>
        <a href="/" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#9C4B25] text-white text-xs font-bold rounded-xl shadow-xs">
          Browse All Recipes →
        </a>
      </div>
    )}

  </div>
</Layout>
