---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');
const searchIndex = recipes.map((r) => ({
  slug: r.id.replace(/\.(md|mdx)$/, ''),
  title: r.data.title,
  description: r.data.description,
  categories: r.data.categories,
  cuisine: r.data.cuisine,
  tags: r.data.tags,
  dietary: r.data.dietary,
  difficulty: r.data.difficulty,
  prepTimeMinutes: r.data.prepTimeMinutes,
  cookTimeMinutes: r.data.cookTimeMinutes,
  servings: r.data.servings,
  ingredients: r.data.ingredients.flatMap((g) => g.items.map((i) => i.name.toLowerCase())),
}));
---

<Layout title="Search Recipes & Ingredients | The Cozy Skillet">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <div class="text-center max-w-xl mx-auto mb-8">
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#4A3F35] mb-2">
        Recipe & Ingredient Search
      </h1>
      <p class="text-sm text-[#6B5B4F]">
        Search by fridge ingredients (e.g. "chicken", "paneer", "butter"), dish types, cuisines, or tags like "One-Pan".
      </p>
    </div>

    <!-- Search Input -->
    <div class="relative max-w-xl mx-auto mb-10">
      <input 
        type="search" 
        id="search-input" 
        placeholder="Search paneer, pasta, garlic, one-pan, snacks..." 
        aria-label="Search recipes by ingredient, cuisine, or tag"
        class="w-full px-5 py-4 pl-12 bg-white border border-[#EBE5D9] rounded-2xl text-[#4A3F35] placeholder:text-[#6B5B4F]/60 text-base shadow-sm focus:border-[#9C4B25] focus:ring-2 focus:ring-[#9C4B25]/20 focus:outline-none transition-all"
        autofocus
      />
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-[#6B5B4F]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
    </div>

    <!-- Results Status -->
    <div class="flex items-center justify-between text-xs font-semibold text-[#6B5B4F] mb-4 px-1" id="results-count">
      Showing all {recipes.length} recipes
    </div>

    <!-- Search Results Container -->
    <div id="results-list" class="space-y-4" data-index={JSON.stringify(searchIndex)}>
      {searchIndex.map((r) => (
        <a 
          href={`/recipes/${r.slug}`}
          class="recipe-search-item flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 sm:p-6 bg-white border border-[#EBE5D9] rounded-2xl hover:border-[#9C4B25] transition-all group"
        >
          <div>
            <div class="flex items-center gap-2 mb-1.5 flex-wrap">
              <span class="text-xs font-bold uppercase tracking-wider text-[#9C4B25]">
                {r.categories[0] || 'Recipe'}
              </span>
              <span class="text-xs text-[#6B5B4F]">•</span>
              <span class="text-xs text-[#6B5B4F]">{r.cuisine.join(', ')}</span>
              {r.tags.map((tag: string) => (
                <span class="text-[10px] bg-[#FAF3EE] text-[#4A3F35] px-2 py-0.5 rounded-md font-medium border border-[#EBE5D9]">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="text-lg font-serif font-bold text-[#4A3F35] group-hover:text-[#9C4B25] transition-colors">
              {r.title}
            </h3>
            <p class="text-xs text-[#5F5045] line-clamp-1 mt-1">
              {r.description}
            </p>
          </div>

          <div class="flex items-center gap-3 text-xs text-[#6B5B4F] flex-shrink-0">
            <span class="bg-[#FAF3EE] px-3 py-1.5 rounded-xl font-semibold text-[#4A3F35]">
              ⏱️ {r.prepTimeMinutes + r.cookTimeMinutes} mins
            </span>
            <span class="font-bold text-[#9C4B25]">View Recipe →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- No results state -->
    <div id="no-results" class="hidden text-center py-12 bg-white rounded-3xl border border-[#EBE5D9] p-8">
      <div class="text-3xl mb-2">🍳</div>
      <h3 class="text-lg font-serif font-bold text-[#4A3F35]">No matching recipes found</h3>
      <p class="text-xs text-[#6B5B4F] mt-1">Try searching for ingredients like "garlic", "butter", "paneer", or tags like "One-Pan".</p>
    </div>

  </div>
</Layout>

<script>
  interface SearchItem {
    slug: string;
    title: string;
    description: string;
    categories: string[];
    cuisine: string[];
    tags: string[];
    dietary: string[];
    difficulty: string;
    prepTimeMinutes: number;
    cookTimeMinutes: number;
    servings: number;
    ingredients: string[];
  }

  function setupSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const container = document.getElementById('results-list');
    const noResults = document.getElementById('no-results');
    const countEl = document.getElementById('results-count');
    if (!container || !input || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    let data: SearchItem[] = [];
    try {
      data = JSON.parse(container.dataset.index || '[]');
    } catch {
      data = [];
    }

    const items = container.querySelectorAll<HTMLElement>('.recipe-search-item');

    function performSearch(rawQuery: string, updateUrl = true) {
      const query = rawQuery.trim().toLowerCase();
      const tokens = query.split(/\s+/).filter(Boolean);
      let matchedCount = 0;

      data.forEach((r, idx) => {
        const itemEl = items[idx];
        if (!itemEl) return;

        if (tokens.length === 0) {
          itemEl.style.display = 'flex';
          matchedCount++;
          return;
        }

        // Each token must match somewhere in title, description, category, cuisine, tags, dietary, or ingredients
        const allTokensMatch = tokens.every((token) => {
          const matchesTitle = r.title.toLowerCase().includes(token);
          const matchesDesc = r.description.toLowerCase().includes(token);
          const matchesCategories = r.categories.some((c) => c.toLowerCase().includes(token));
          const matchesCuisine = r.cuisine.some((c) => c.toLowerCase().includes(token));
          const matchesTags = r.tags.some((t) => t.toLowerCase().includes(token));
          const matchesIngredients = r.ingredients.some((ing) => ing.includes(token));
          const matchesDietary = r.dietary.some((d) => d.toLowerCase().includes(token));

          return matchesTitle || matchesDesc || matchesCategories || matchesCuisine || matchesTags || matchesIngredients || matchesDietary;
        });

        if (allTokensMatch) {
          itemEl.style.display = 'flex';
          matchedCount++;
        } else {
          itemEl.style.display = 'none';
        }
      });

      if (countEl) {
        countEl.textContent = query 
          ? `Found ${matchedCount} ${matchedCount === 1 ? 'recipe' : 'recipes'} matching "${query}"`
          : `Showing all ${data.length} recipes`;
      }

      if (matchedCount === 0) {
        noResults?.classList.remove('hidden');
      } else {
        noResults?.classList.add('hidden');
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (query) {
          url.searchParams.set('q', query);
        } else {
          url.searchParams.delete('q');
        }
        window.history.replaceState({}, '', url.toString());
      }
    }

    // Pre-populate and run search from URL parameter on load
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    if (initialQuery) {
      input.value = initialQuery;
      performSearch(initialQuery, false);
    }

    input.addEventListener('input', () => {
      performSearch(input.value, true);
    });
  }

  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
</script>
