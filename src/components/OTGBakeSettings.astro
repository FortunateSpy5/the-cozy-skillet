---
export interface OTGProfile {
  preheatTempC: number;
  preheatMins: number;
  bakeTempC: number;
  rodMode: string;
  rackPosition: string;
  bakingVessel: string;
  foilTentCue?: string;
}

export interface Props {
  profile: OTGProfile;
}

const { profile } = Astro.props;
---

<div class="bg-gradient-to-br from-amber-50/90 to-[#FAF3EE] border-2 border-amber-200/80 rounded-3xl p-4 sm:p-6 lg:p-8 shadow-xs mb-6 sm:mb-8">
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-amber-200/60 mb-4">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-2xl bg-amber-900 text-amber-50 flex items-center justify-center text-lg font-bold shadow-2xs">
        📟
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-serif font-bold text-amber-950 flex items-center gap-2">
          <span>OTG Bake Profile & Rack Positioning</span>
          <span class="text-[10px] font-sans font-bold uppercase tracking-wider bg-amber-200/80 text-amber-900 px-2 py-0.5 rounded-full border border-amber-300">
            100% Oven Calibrated
          </span>
        </h2>
        <p class="text-xs text-[#6B5B4F] mt-0.5">Tested for tabletop Indian OTGs (Bajaj, Morphy Richards, Borosil, Agaro, Wonderchef 25L–60L).</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
    <!-- 1. True Preheat -->
    <div class="bg-white/90 p-3 rounded-2xl border border-amber-200/70 shadow-2xs">
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#9C4B25] flex items-center gap-1 mb-1">
        <span>⏱️</span>
        <span>True Preheat</span>
      </div>
      <div class="text-sm font-bold text-[#4A3F35]">
        {profile.preheatTempC}°C
      </div>
      <div class="text-[11px] text-[#6B5B4F]">
        {profile.preheatMins || 15} mins (Both Rods)
      </div>
    </div>

    <!-- 2. Target Bake Temp -->
    <div class="bg-white/90 p-3 rounded-2xl border border-amber-200/70 shadow-2xs">
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#9C4B25] flex items-center gap-1 mb-1">
        <span>🔥</span>
        <span>Bake Temp</span>
      </div>
      <div class="text-sm font-bold text-[#4A3F35]">
        {profile.bakeTempC}°C
      </div>
      <div class="text-[11px] text-[#6B5B4F]">
        ({Math.round((profile.bakeTempC * 9) / 5 + 32)}°F)
      </div>
    </div>

    <!-- 3. Heating Element Mode -->
    <div class="bg-white/90 p-3 rounded-2xl border border-amber-200/70 shadow-2xs col-span-2 sm:col-span-1">
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#9C4B25] flex items-center gap-1 mb-1">
        <span>⚡</span>
        <span>Heating Rods</span>
      </div>
      <div class="text-xs font-bold text-[#4A3F35] leading-snug">
        {profile.rodMode}
      </div>
    </div>

    <!-- 4. Rack Position Slot -->
    <div class="bg-white/90 p-3 rounded-2xl border border-amber-200/70 shadow-2xs col-span-2 sm:col-span-1">
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#9C4B25] flex items-center gap-1 mb-1">
        <span>📍</span>
        <span>Rack Position</span>
      </div>
      <div class="text-xs font-semibold text-[#4A3F35] leading-snug">
        {profile.rackPosition}
      </div>
    </div>

    <!-- 5. Baking Pan / Vessel -->
    <div class="bg-white/90 p-3 rounded-2xl border border-amber-200/70 shadow-2xs col-span-2 md:col-span-1">
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#9C4B25] flex items-center gap-1 mb-1">
        <span>🍞</span>
        <span>Pan / Vessel</span>
      </div>
      <div class="text-xs font-semibold text-[#4A3F35] leading-snug">
        {profile.bakingVessel}
      </div>
    </div>

    <!-- 6. Top-Rod Foil Shield Cue -->
    <div class="bg-white/90 p-3 rounded-2xl border border-amber-200/70 shadow-2xs col-span-2 md:col-span-1">
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#9C4B25] flex items-center gap-1 mb-1">
        <span>🛡️</span>
        <span>Foil Shield Cue</span>
      </div>
      <div class="text-xs text-[#5F5045] leading-snug">
        {profile.foilTentCue || 'No foil needed'}
      </div>
    </div>
  </div>
</div>
