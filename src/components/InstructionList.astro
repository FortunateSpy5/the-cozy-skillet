---
export interface InstructionStep {
  step: number;
  title?: string;
  text: string;
  durationMinutes?: number;
  summerDurationMinutes?: number;
  winterDurationMinutes?: number;
}

export interface Props {
  instructions: InstructionStep[];
  isBaking?: boolean;
}

const { instructions, isBaking = false } = Astro.props;

// Check if any step provides seasonal climate-specific proofing durations
const hasClimateSteps = instructions.some(
  (inst) => inst.summerDurationMinutes !== undefined || inst.winterDurationMinutes !== undefined
);
---

<div class="bg-white rounded-3xl border border-[#EBE5D9] p-4 sm:p-6 lg:p-8 shadow-xs" id="instructions-container" data-is-baking={isBaking ? 'true' : 'false'}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-[#EBE5D9] gap-4">
    <div>
      <h2 class="text-2xl font-serif font-bold text-[#4A3F35]">Instructions</h2>
      <p class="text-xs text-[#6B5B4F] mt-0.5">Follow step-by-step. Mark items done as you cook.</p>
    </div>

    <!-- Indian Kitchen Climate Toggle for Fermentation / Proofing -->
    {hasClimateSteps && (
      <div class="flex items-center gap-2 bg-[#FAF3EE] p-1.5 rounded-2xl border border-[#EBE5D9] self-start sm:self-auto">
        <span class="text-xs font-semibold text-[#6B5B4F] px-2 flex items-center gap-1">
          <span>Kitchen:</span>
        </span>
        <div class="flex items-center gap-1" id="climate-toggle-group">
          <button 
            type="button" 
            class="climate-btn text-xs font-bold py-1.5 px-3 rounded-xl transition-all bg-[#9C4B25] text-white shadow-2xs cursor-pointer" 
            data-climate="summer"
            aria-pressed="true"
            aria-label="Set proofing timers for warm kitchen (>28°C)"
          >
            ☀️ Warm (&gt;28°C)
          </button>
          <button 
            type="button" 
            class="climate-btn text-xs font-bold py-1.5 px-3 rounded-xl transition-all bg-white text-[#6B5B4F] hover:text-[#9C4B25] shadow-2xs cursor-pointer" 
            data-climate="winter"
            aria-pressed="false"
            aria-label="Set proofing timers for cool kitchen (<24°C)"
          >
            ❄️ Cool (&lt;24°C)
          </button>
        </div>
      </div>
    )}
  </div>

  <div class="mt-6 space-y-6">
    {instructions.map((inst) => {
      const hasSeasonal = inst.summerDurationMinutes !== undefined && inst.winterDurationMinutes !== undefined;
      const initialMinutes = inst.summerDurationMinutes ?? inst.durationMinutes;

      return (
        <div class="instruction-card relative p-4 sm:p-5 rounded-2xl transition-all border border-[#EBE5D9]/60 hover:border-[#EBE5D9] bg-[#FAF3EE]/20 hover:bg-[#FAF3EE]/50 space-y-3" data-step={inst.step}>
          <!-- Step Header: Number + Title + Timer (Full width inline) -->
          <div class="flex flex-wrap items-center justify-between gap-2.5 pb-1 border-b border-[#EBE5D9]/50">
            <div class="flex items-center gap-2.5 min-w-0">
              <!-- Step Number Badge -->
              <span class="flex-shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-[#9C4B25] text-white flex items-center justify-center font-bold text-xs sm:text-sm shadow-xs step-badge">
                {inst.step}
              </span>
              {inst.title && (
                <h3 class="text-base sm:text-lg font-bold text-[#4A3F35] truncate">
                  {inst.title}
                </h3>
              )}
            </div>

            <!-- Step Timer Button -->
            {(initialMinutes || hasSeasonal) && (
              <button 
                type="button" 
                class="step-timer-btn inline-flex items-center gap-1.5 min-h-[38px] px-3 py-1.5 bg-[#FAF3EE] hover:bg-[#9C4B25] hover:text-white text-[#9C4B25] border border-[#EBE5D9] rounded-xl text-xs font-bold transition-all cursor-pointer shadow-2xs shrink-0"
                data-minutes={initialMinutes}
                data-summer={inst.summerDurationMinutes}
                data-winter={inst.winterDurationMinutes}
                data-base-duration={inst.durationMinutes}
                aria-label={`Start timer for step ${inst.step}`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span class="timer-label">
                  {hasSeasonal ? `${initialMinutes}m proof (Summer)` : `${initialMinutes} min timer`}
                </span>
              </button>
            )}
          </div>

          <!-- Instruction Text (Full Width, Zero Left Indent!) -->
          <p class="text-sm sm:text-base text-[#5F5045] leading-relaxed instruction-text w-full">
            {inst.text}
          </p>

          <label class="inline-flex items-center gap-2 pt-1 text-xs text-[#6B5B4F] cursor-pointer hover:text-[#9C4B25] select-none">
            <input 
              type="checkbox" 
              class="step-checkbox rounded border-[#D5CDC1] text-[#9C4B25] focus:ring-[#9C4B25] w-4 h-4 cursor-pointer" 
              aria-label={`Mark step ${inst.step} as done`}
            />
            <span>Mark step as done</span>
          </label>
        </div>
      );
    })}
  </div>
</div>

<!-- Active Floating Kitchen Timer Bar -->
<div id="floating-timer" class="fixed bottom-20 right-4 sm:bottom-6 sm:right-6 z-50 hidden bg-[#4A3F35] text-white p-4 rounded-2xl shadow-xl border border-white/20 items-center gap-4 no-print">
  <div class="flex items-center gap-2.5">
    <div class="w-8 h-8 rounded-xl bg-[#9C4B25] flex items-center justify-center animate-pulse" aria-hidden="true">
      ⏱️
    </div>
    <div>
      <div id="timer-status-label" class="text-[10px] uppercase font-bold tracking-wider text-amber-200">Timer Running</div>
      <div id="timer-display" class="text-xl font-mono font-bold tracking-tight" role="timer" aria-label="Active step timer">00:00</div>
      <div id="timer-announcer" class="sr-only" role="status" aria-live="polite"></div>
    </div>
  </div>
  <button id="cancel-timer" class="min-h-[44px] min-w-[44px] px-3.5 py-2 text-xs bg-white/10 hover:bg-white/20 rounded-xl font-medium transition-colors cursor-pointer" aria-label="Cancel active timer">
    Cancel
  </button>
</div>

<script>
  let timerInterval: number | ReturnType<typeof setInterval> | null = null;
  let sharedAudioCtx: AudioContext | null = null;

  function getAudioContext(): AudioContext | null {
    if (!sharedAudioCtx) {
      const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioCtxClass) {
        sharedAudioCtx = new AudioCtxClass();
      }
    }
    if (sharedAudioCtx && sharedAudioCtx.state === 'suspended') {
      sharedAudioCtx.resume();
    }
    return sharedAudioCtx;
  }

  function playAcousticChime() {
    try {
      const ctx = getAudioContext();
      if (!ctx) return;

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.type = 'sine';
      osc.frequency.setValueAtTime(880, ctx.currentTime); // A5 note
      osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.8); // Gentle drop to A4
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.8);

      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.8);
    } catch {
      // Audio autoplay policy fallback
    }
  }

  function setupInstructions() {
    const container = document.getElementById('instructions-container');
    if (!container || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    // Step completion toggle
    const cards = container.querySelectorAll<HTMLElement>('.instruction-card');
    cards.forEach((card) => {
      const checkbox = card.querySelector<HTMLInputElement>('.step-checkbox');
      const text = card.querySelector<HTMLElement>('.instruction-text');
      const badge = card.querySelector<HTMLElement>('.step-badge');

      checkbox?.addEventListener('change', () => {
        if (checkbox.checked) {
          text?.classList.add('opacity-50');
          badge?.classList.remove('bg-[#9C4B25]');
          badge?.classList.add('bg-[#4A7C59]'); // Sage green completed
        } else {
          text?.classList.remove('opacity-50');
          badge?.classList.add('bg-[#9C4B25]');
          badge?.classList.remove('bg-[#4A7C59]');
        }
      });
    });

    // Climate Preset Toggle
    const climateBtns = container.querySelectorAll<HTMLButtonElement>('.climate-btn');
    const timerButtons = container.querySelectorAll<HTMLButtonElement>('.step-timer-btn');

    function setClimate(climate: 'summer' | 'winter') {
      climateBtns.forEach((btn) => {
        const isCurrent = btn.dataset.climate === climate;
        btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          btn.classList.add('bg-[#9C4B25]', 'text-white');
          btn.classList.remove('bg-white', 'text-[#6B5B4F]');
        } else {
          btn.classList.remove('bg-[#9C4B25]', 'text-white');
          btn.classList.add('bg-white', 'text-[#6B5B4F]');
        }
      });

      timerButtons.forEach((btn) => {
        const summerVal = btn.dataset.summer;
        const winterVal = btn.dataset.winter;
        const labelSpan = btn.querySelector<HTMLElement>('.timer-label');

        if (summerVal && winterVal) {
          const val = climate === 'summer' ? summerVal : winterVal;
          btn.dataset.minutes = val;
          if (labelSpan) {
            labelSpan.textContent = climate === 'summer' ? `${val}m proof (Summer)` : `${val}m proof (Winter)`;
          }
        }
      });
    }

    climateBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const c = (btn.dataset.climate || 'summer') as 'summer' | 'winter';
        setClimate(c);
      });
    });

    // Timer functionality with wall-clock time math (immune to background tab throttling)
    const timerBar = document.getElementById('floating-timer');
    const timerDisplay = document.getElementById('timer-display');
    const timerStatusLabel = document.getElementById('timer-status-label');
    const timerAnnouncer = document.getElementById('timer-announcer');
    const cancelBtn = document.getElementById('cancel-timer');

    cancelBtn?.addEventListener('click', () => {
      if (timerInterval !== null) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
      if (timerAnnouncer) timerAnnouncer.textContent = 'Active timer closed.';
      timerBar?.classList.add('hidden');
      timerBar?.classList.remove('flex', 'bg-emerald-900', 'border-emerald-400', 'animate-pulse');
      timerBar?.classList.add('bg-[#4A3F35]', 'border-white/20');
      if (timerStatusLabel) {
        timerStatusLabel.textContent = 'Timer Running';
        timerStatusLabel.classList.remove('text-emerald-200');
        timerStatusLabel.classList.add('text-amber-200');
      }
      if (cancelBtn) cancelBtn.textContent = 'Cancel';
    });

    timerButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Unlock Web Audio context during user click gesture
        getAudioContext();

        const minutes = parseInt(btn.dataset.minutes || '5', 10);
        const targetEndTime = Date.now() + minutes * 60 * 1000;

        if (timerInterval !== null) {
          clearInterval(timerInterval);
          timerInterval = null;
        }

        if (timerAnnouncer) timerAnnouncer.textContent = `Timer started for ${minutes} minutes.`;

        // Reset timer bar state
        timerBar?.classList.remove('hidden', 'bg-emerald-900', 'border-emerald-400', 'animate-pulse');
        timerBar?.classList.add('flex', 'bg-[#4A3F35]', 'border-white/20');
        if (timerStatusLabel) {
          timerStatusLabel.textContent = 'Timer Running';
          timerStatusLabel.classList.remove('text-emerald-200');
          timerStatusLabel.classList.add('text-amber-200');
        }
        if (cancelBtn) cancelBtn.textContent = 'Cancel';

        function updateDisplay() {
          const now = Date.now();
          const remainingMs = targetEndTime - now;
          const remainingSeconds = Math.max(0, Math.ceil(remainingMs / 1000));

          const m = Math.floor(remainingSeconds / 60);
          const s = remainingSeconds % 60;
          if (timerDisplay) {
            timerDisplay.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
          }

          if (remainingSeconds <= 0) {
            if (timerInterval !== null) {
              clearInterval(timerInterval);
              timerInterval = null;
            }
            playAcousticChime();
            if (timerDisplay) timerDisplay.textContent = 'DONE! 🎉';
            if (timerBar) {
              timerBar.classList.remove('bg-[#4A3F35]', 'border-white/20');
              timerBar.classList.add('bg-emerald-900', 'border-emerald-400', 'animate-pulse');
            }
            if (timerStatusLabel) {
              timerStatusLabel.textContent = 'Timer Complete!';
              timerStatusLabel.classList.remove('text-amber-200');
              timerStatusLabel.classList.add('text-emerald-200');
            }
            if (cancelBtn) cancelBtn.textContent = 'Dismiss';
            if (timerAnnouncer) timerAnnouncer.textContent = 'Timer complete! Cooking step finished.';
            if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
              navigator.vibrate([200, 100, 200]);
            }
          }
        }

        updateDisplay();
        timerInterval = setInterval(updateDisplay, 500);
      });
    });
  }

  // Cleanup active intervals on navigation
  document.addEventListener('astro:before-swap', () => {
    if (timerInterval !== null) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
  });

  setupInstructions();
  document.addEventListener('astro:page-load', setupInstructions);
</script>
