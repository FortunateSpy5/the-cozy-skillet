---
export interface Props {
  slug: string;
  title: string;
  description: string;
  categories: string[];
  cuisine: string[];
  tags?: string[];
  dietary: string[];
  difficulty: string;
  prepTimeMinutes: number;
  cookTimeMinutes: number;
  servings: number;
  bakingType?: string;
}

const {
  slug,
  title,
  description,
  categories,
  cuisine,
  tags = [],
  dietary,
  difficulty,
  prepTimeMinutes,
  cookTimeMinutes,
  servings,
  bakingType,
} = Astro.props;

const totalMinutes = prepTimeMinutes + cookTimeMinutes;
const primaryCategory = categories[0] || 'Recipe';
const primaryCuisine = cuisine.join(', ');
---

<a 
  href={`/recipes/${slug}`} 
  class="group flex flex-col bg-white rounded-3xl border border-[#EBE5D9] hover:border-[#9C4B25]/40 hover:shadow-lg transition-all duration-200 overflow-hidden"
>
  <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
    <div>
      <!-- Top badges: Categories & Difficulty -->
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-[#9C4B25] bg-[#FAF3EE] px-2.5 py-1 rounded-xl truncate max-w-[200px]">
          {bakingType || primaryCategory}
        </span>
        <span class={`text-[11px] font-bold px-2 py-0.5 rounded-lg border ${difficulty === 'Easy' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-amber-50 text-amber-800 border-amber-200'}`}>
          {difficulty}
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-xl sm:text-2xl font-serif font-bold text-[#4A3F35] group-hover:text-[#9C4B25] transition-colors leading-tight mb-2.5">
        {title}
      </h3>

      <!-- Short Description -->
      <p class="text-sm text-[#5F5045] line-clamp-2 leading-relaxed mb-4">
        {description}
      </p>
    </div>

    <div>
      <!-- Cuisine & Practical Badges -->
      <div class="flex flex-wrap gap-1.5 mb-5">
        <span class="text-[11px] font-semibold text-[#9C4B25] bg-[#FAF3EE] px-2 py-0.5 rounded-lg">
          {primaryCuisine}
        </span>
        {tags.map((tag) => (
          <span class="text-[11px] font-medium text-[#4A3F35] bg-[#FDFBF7] border border-[#EBE5D9] px-2 py-0.5 rounded-lg">
            {tag}
          </span>
        ))}
        {dietary.map((d) => (
          <span class="text-[11px] font-medium text-[#6B5B4F] bg-[#FDFBF7] border border-[#EBE5D9] px-2 py-0.5 rounded-lg">
            {d}
          </span>
        ))}
      </div>

      <!-- Metadata footer -->
      <div class="pt-4 border-t border-[#EBE5D9] flex items-center justify-between text-xs text-[#6B5B4F]">
        <div class="flex items-center gap-1.5 font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#9C4B25]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>{totalMinutes} mins total</span>
        </div>
        <div class="flex items-center gap-1 font-medium">
          <span>Serves {servings}</span>
        </div>
      </div>
    </div>
  </div>
</a>
