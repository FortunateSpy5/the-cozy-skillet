---
import { getOptimizedImageUrl, getResponsiveImageSrcSet } from '../utils/images';

export interface Props {
  slug: string;
  title: string;
  description: string;
  categories: string[];
  cuisine: string[];
  tags?: string[];
  dietary: string[];
  difficulty: string;
  prepTimeMinutes: number;
  cookTimeMinutes: number;
  proofTimeMinutes?: number;
  hydration?: number | string;
  servings: number;
  bakingType?: string;
  image?: string;
  imageAlt?: string;
  priority?: boolean;
}

const {
  slug,
  title,
  description,
  categories,
  cuisine,
  tags = [],
  dietary = [],
  difficulty,
  prepTimeMinutes,
  cookTimeMinutes,
  proofTimeMinutes,
  hydration,
  servings,
  bakingType,
  image,
  imageAlt,
  priority = false,
} = Astro.props;

const totalMinutes = prepTimeMinutes + cookTimeMinutes + (proofTimeMinutes || 0);
const primaryCategory = categories[0] || 'Recipe';
const primaryCuisine = cuisine.join(', ');

// Sanitize tags: only allow "Quick" badge if totalMinutes <= 30
const isActuallyQuick = totalMinutes <= 30;
const sanitizedTags = tags.filter((t) => {
  if (t.toLowerCase().includes('quick') && !isActuallyQuick) return false;
  return true;
});

// Curate display badges to prevent visual clutter (max 3-4 key badges)
const displayTag = sanitizedTags[0];
const displayDietary = dietary.slice(0, 2);

// Responsive optimized image URLs (WebP via Netlify Image CDN in production)
const optimizedCardImage = getOptimizedImageUrl(image, { width: 640, quality: 75, format: 'webp' });
const cardSrcSet = getResponsiveImageSrcSet(image, [400, 640], { quality: 75, format: 'webp' });
---

<a 
  href={`/recipes/${slug}/`} 
  class="recipe-card group flex flex-col bg-white rounded-3xl border border-[#EBE5D9] hover:border-[#9C4B25]/40 hover:shadow-lg transition-all duration-200 overflow-hidden"
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-categories={categories.map((c) => c.toLowerCase()).join(' ')}
  data-dietary={dietary.map((d) => d.toLowerCase()).join(' ')}
  data-tags={sanitizedTags.map((t) => t.toLowerCase()).join(' ')}
  data-cuisine={cuisine.map((c) => c.toLowerCase()).join(' ')}
>
  {image && (
    <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#FAF3EE] border-b border-[#EBE5D9]/60">
      <img 
        src={optimizedCardImage} 
        srcset={cardSrcSet}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
        alt={imageAlt || title} 
        loading={priority ? "eager" : "lazy"} 
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        width="640"
        height="400"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/15 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
    </div>
  )}

  <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
    <div>
      <!-- Top badges: Categories & Difficulty -->
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-[#9C4B25] bg-[#FAF3EE] px-2.5 py-1 rounded-xl truncate max-w-[200px]">
          {bakingType || primaryCategory}
        </span>
        <span class={`text-[11px] font-bold px-2 py-0.5 rounded-lg border ${difficulty === 'Easy' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-amber-50 text-amber-800 border-amber-200'}`}>
          {difficulty}
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-xl sm:text-2xl font-serif font-bold text-[#4A3F35] group-hover:text-[#9C4B25] transition-colors leading-tight mb-2.5">
        {title}
      </h3>

      <!-- Short Description -->
      <p class="text-sm text-[#5F5045] line-clamp-2 leading-relaxed mb-4">
        {description}
      </p>
    </div>

    <div>
      <!-- Focused, High-Signal Badges -->
      <div class="flex flex-wrap items-center gap-1.5 mb-5">
        <span class="text-[11px] font-semibold text-[#9C4B25] bg-[#FAF3EE] px-2 py-0.5 rounded-lg border border-[#EBE5D9]/60">
          {primaryCuisine}
        </span>
        {hydration && (
          <span class="text-[11px] font-semibold text-amber-900 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200">
            💧 {typeof hydration === 'number' ? `${hydration}%` : hydration} Hydration
          </span>
        )}
        {displayTag && (
          <span class="text-[11px] font-medium text-[#4A3F35] bg-[#FDFBF7] border border-[#EBE5D9] px-2 py-0.5 rounded-lg">
            {displayTag}
          </span>
        )}
        {displayDietary.map((d) => (
          <span class={`text-[11px] font-medium px-2 py-0.5 rounded-lg border ${d.toLowerCase() === 'vegetarian' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-[#FDFBF7] text-[#6B5B4F] border-[#EBE5D9]'}`}>
            {d}
          </span>
        ))}
      </div>

      <!-- Metadata footer: Split active hands-on time vs passive proof time -->
      <div class="pt-4 border-t border-[#EBE5D9] flex items-center justify-between text-xs text-[#6B5B4F]">
        <div class="flex items-center gap-1.5 font-medium" title={proofTimeMinutes ? `${prepTimeMinutes}m active prep, ${proofTimeMinutes}m passive rise, ${cookTimeMinutes}m bake` : `${prepTimeMinutes} minutes prep, ${cookTimeMinutes} minutes active cook`}>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#9C4B25]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          {proofTimeMinutes ? (
            <span>{prepTimeMinutes}m active • {proofTimeMinutes}m rise • {cookTimeMinutes}m bake <span class="text-[#9C4B25] font-semibold">({totalMinutes}m)</span></span>
          ) : (
            <span>{prepTimeMinutes}m prep • {cookTimeMinutes}m cook <span class="text-[#9C4B25] font-semibold">({totalMinutes}m total)</span></span>
          )}
        </div>
        <div class="flex items-center gap-1 font-medium">
          <span>{bakingType ? `Yields ${servings}` : `Serves ${servings}`}</span>
        </div>
      </div>
    </div>
  </div>
</a>
