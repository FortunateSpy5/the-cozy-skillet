---
import GroceryExporter from './GroceryExporter.astro';

export interface IngredientItem {
  name: string;
  amount?: number | string;
  unit?: string;
  metricAmount?: number | string;
  metricUnit?: string;
  notes?: string;
  optional?: boolean;
  boosterEffect?: string;
  bakersPercentage?: number;
}

export interface IngredientGroup {
  category?: string;
  groupTitle?: string;
  items: IngredientItem[];
}

export interface Props {
  ingredients: IngredientGroup[];
  servings: number;
  recipeTitle?: string;
  isBaking?: boolean;
  bakerFlourWeight?: number;
}

const { ingredients, servings, recipeTitle = 'Recipe', isBaking = false, bakerFlourWeight } = Astro.props;

// Calculate base flour weight for Baker's Percentages if baking
const calculatedFlourWeight = (() => {
  if (bakerFlourWeight && bakerFlourWeight > 0) return bakerFlourWeight;
  let total = 0;
  for (const group of ingredients) {
    for (const item of group.items) {
      const lower = item.name.toLowerCase();
      if ((lower.includes('flour') || lower.includes('maida') || lower.includes('atta')) && typeof item.metricAmount === 'number' && !item.optional) {
        total += item.metricAmount;
      }
    }
  }
  return total > 0 ? total : 0;
})();
---

<div class="bg-white rounded-3xl border border-[#EBE5D9] p-4 sm:p-6 shadow-xs" id="ingredient-card" data-is-baking={isBaking ? 'true' : 'false'}>
  <!-- Header & Serving Scaler & Unit Preferences -->
  <div class="pb-5 border-b border-[#EBE5D9] space-y-3">
    <div>
      <h2 class="text-2xl font-serif font-bold text-[#4A3F35]">Ingredients</h2>
      <p class="text-xs text-[#6B5B4F] mt-0.5">Click ingredients to cross them off. Dual weight & volume provided.</p>
    </div>

    <!-- Controls Toolbar (Units & Servings Scaler) -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 pt-1">
      <!-- Unit Preference Toggle (Dual | Grams | Cups | Baker's %) -->
      <div class="flex items-center gap-1 bg-[#FAF3EE] p-1 rounded-2xl border border-[#EBE5D9]">
        <button 
          type="button" 
          class="unit-pref-btn text-xs font-bold py-1 px-2.5 sm:px-3 rounded-xl transition-all bg-[#9C4B25] text-white cursor-pointer" 
          data-pref="dual" 
          aria-pressed="true"
          aria-label="Show dual units (cups and grams)"
        >
          Dual
        </button>
        <button 
          type="button" 
          class="unit-pref-btn text-xs font-bold py-1 px-2.5 sm:px-3 rounded-xl transition-all bg-white text-[#6B5B4F] hover:text-[#9C4B25] cursor-pointer" 
          data-pref="metric" 
          aria-pressed="false"
          aria-label="Show metric weight in grams"
        >
          Grams
        </button>
        <button 
          type="button" 
          class="unit-pref-btn text-xs font-bold py-1 px-2.5 sm:px-3 rounded-xl transition-all bg-white text-[#6B5B4F] hover:text-[#9C4B25] cursor-pointer" 
          data-pref="volume" 
          aria-pressed="false"
          aria-label="Show volume in cups and spoons"
        >
          Cups
        </button>
        {isBaking && (
          <button 
            type="button" 
            id="bakers-pct-toggle"
            class="text-xs font-bold py-1 px-2.5 sm:px-3 rounded-xl transition-all bg-white text-[#6B5B4F] hover:text-[#9C4B25] cursor-pointer flex items-center gap-1" 
            aria-pressed="false"
            aria-label="Toggle Baker's percentage tags"
          >
            <span>⚖️</span>
            <span>Baker's %</span>
          </button>
        )}
      </div>

      <!-- Scaler Control -->
      <div class="flex items-center gap-1.5 bg-[#FAF3EE] p-1 rounded-2xl border border-[#EBE5D9]">
        <span class="text-xs font-semibold text-[#6B5B4F] px-1.5 flex items-center gap-1">
          <span>{isBaking ? 'Yield:' : 'Servings:'}</span>
          <strong id="display-servings" class="text-[#9C4B25]" data-original={servings}>{servings}</strong>
        </span>
        <div class="flex items-center gap-1">
          <button type="button" class="scale-btn text-xs font-bold py-1 px-2.5 rounded-xl transition-all bg-white text-[#9C4B25] shadow-xs hover:bg-[#9C4B25] hover:text-white cursor-pointer min-w-[34px]" data-multiplier="0.5" aria-pressed="false" aria-label="Scale ingredients to half servings">0.5x</button>
          <button type="button" class="scale-btn text-xs font-bold py-1 px-2.5 rounded-xl transition-all bg-[#9C4B25] text-white shadow-xs cursor-pointer min-w-[34px]" data-multiplier="1" aria-pressed="true" aria-label="Scale ingredients to 1x original servings">1x</button>
          <button type="button" class="scale-btn text-xs font-bold py-1 px-2.5 rounded-xl transition-all bg-white text-[#9C4B25] shadow-xs hover:bg-[#9C4B25] hover:text-white cursor-pointer min-w-[34px]" data-multiplier="2" aria-pressed="false" aria-label="Scale ingredients to double servings">2x</button>
          {!isBaking && (
            <button type="button" class="scale-btn text-xs font-bold py-1 px-2.5 rounded-xl transition-all bg-white text-[#9C4B25] shadow-xs hover:bg-[#9C4B25] hover:text-white cursor-pointer min-w-[34px]" data-multiplier="3" aria-pressed="false" aria-label="Scale ingredients to triple servings">3x</button>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Baking Multiplier Warning Banner -->
  <div id="baking-scale-warning" class="hidden mt-4 p-3.5 bg-amber-50 border border-amber-200 rounded-2xl text-xs text-amber-900 items-center gap-2.5">
    <span class="text-base">⚠️</span>
    <span><strong>Baking Vessel Warning:</strong> When doubling (2x), divide the dough across 2 skillets or loaf tins; do not crowd into a single pan.</span>
  </div>

  <!-- Mise-en-place Preparation Progress Bar -->
  <div class="mt-4 pt-4 border-t border-[#EBE5D9]/60">
    <div class="flex items-center justify-between text-xs font-semibold text-[#6B5B4F] mb-1.5">
      <span class="flex items-center gap-1.5">
        <span class="text-sm">🥣</span>
        <span>Mise-en-Place Prep Checklist</span>
      </span>
      <span id="prep-progress-text" class="text-[#9C4B25] font-bold">0 of 0 prepped (0%)</span>
    </div>
    <div class="w-full bg-[#FAF3EE] rounded-full h-1.5 overflow-hidden border border-[#EBE5D9]">
      <div id="prep-progress-bar" class="bg-[#4A7C59] h-full rounded-full transition-all duration-300 w-0"></div>
    </div>
  </div>

  <!-- Ingredients by Category / Group -->
  <div class="mt-6 space-y-6">
    {ingredients.map((group) => {
      const title = group.groupTitle || group.category;
      return (
        <div>
          {title && title !== 'Ingredients' && (
            <h3 class="text-sm font-bold uppercase tracking-wider text-[#9C4B25] mb-3 flex items-center gap-1.5">
              <span>🥖</span>
              <span>{title}</span>
            </h3>
          )}
          <ul class="space-y-3">
            {group.items.map((item) => {
              const hasNumericAmount = typeof item.amount === 'number';
              const hasNumericMetric = typeof item.metricAmount === 'number';

              // Calculate Baker's percentage if applicable
              let computedBakersPct: number | null = null;
              if (typeof item.bakersPercentage === 'number') {
                computedBakersPct = item.bakersPercentage;
              } else if (calculatedFlourWeight > 0 && hasNumericMetric) {
                computedBakersPct = Math.round(((item.metricAmount as number) / calculatedFlourWeight) * 100);
              }

              return (
                <li class={`ingredient-row flex items-start gap-3 py-2 px-2.5 rounded-xl transition-all cursor-pointer select-none group border border-transparent ${item.optional ? 'bg-amber-50/50 hover:bg-amber-50/90 border-amber-200/60' : 'hover:bg-[#FAF3EE]/70 hover:border-[#EBE5D9]/60'}`}>
                  <input 
                    type="checkbox" 
                    class="mt-1 h-4 w-4 rounded border-[#D5CDC1] text-[#9C4B25] focus:ring-[#9C4B25] cursor-pointer shrink-0"
                    aria-label={`Mark ${item.name} as prepared`}
                  />
                  
                  <div class="flex-1 min-w-0 text-sm sm:text-base leading-snug">
                    <span class="ingredient-text text-[#4A3F35]">
                      {item.amount !== undefined && (
                        <span class="volume-unit-part font-bold text-[#9C4B25]">
                          <span 
                            class="ingredient-amount" 
                            data-base={hasNumericAmount ? item.amount : ''}
                          >
                            {item.amount}
                          </span>
                          {item.unit && <span class="text-xs sm:text-sm font-semibold text-[#6B5B4F]"> {item.unit}</span>}
                        </span>
                      )}

                      {item.metricAmount !== undefined && (
                        <span class="metric-unit-part text-[11px] font-bold text-[#6B5B4F] bg-[#FAF3EE] px-1.5 py-0.5 rounded-md border border-[#EBE5D9] mx-1 inline-block">
                          <span class="metric-amount" data-base={hasNumericMetric ? item.metricAmount : ''}>
                            {item.metricAmount}
                          </span>
                          {item.metricUnit && <span>{item.metricUnit}</span>}
                        </span>
                      )}

                      {computedBakersPct !== null && (
                        <span 
                          class="bakers-unit-part text-[11px] font-bold text-amber-900 bg-amber-100/90 px-1.5 py-0.5 rounded-md border border-amber-300 mx-1" 
                          style="display: none;" 
                          title={`${computedBakersPct}% Baker's Percentage`}
                        >
                          {computedBakersPct}%
                        </span>
                      )}

                      <span class="font-medium text-[#4A3F35]"> {item.name}</span>
                      {item.notes && <span class="text-xs text-[#6B5B4F] italic ml-1">({item.notes})</span>}
                    </span>

                    {item.optional && (
                      <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                        <span class="text-[10px] font-bold uppercase tracking-wider bg-amber-200/80 text-amber-900 border border-amber-300 px-1.5 py-0.5 rounded-md inline-flex items-center gap-0.5 shadow-2xs">
                          <span>✨</span>
                          <span>Optional Booster</span>
                        </span>
                        {item.boosterEffect && (
                          <span class="text-xs text-[#6B5B4F] italic bg-[#FAF3EE] px-1.5 py-0.5 rounded-md border border-[#EBE5D9]">
                            {item.boosterEffect}
                          </span>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </div>

  <GroceryExporter recipeTitle={recipeTitle} />
</div>

<script>
  function setupIngredients() {
    const card = document.getElementById('ingredient-card');
    if (!card || card.dataset.initialized === 'true') return;
    card.dataset.initialized = 'true';

    const isBaking = card.dataset.isBaking === 'true';
    const bakingWarning = document.getElementById('baking-scale-warning');

    // Unit Preference Persistence
    const STORAGE_KEY = 'cozy_unit_pref';
    const unitBtns = card.querySelectorAll<HTMLButtonElement>('.unit-pref-btn');

    function applyUnitPreference(pref: string) {
      unitBtns.forEach((btn) => {
        const isCurrent = btn.dataset.pref === pref;
        btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          btn.classList.add('bg-[#9C4B25]', 'text-white');
          btn.classList.remove('bg-white', 'text-[#6B5B4F]');
        } else {
          btn.classList.remove('bg-[#9C4B25]', 'text-white');
          btn.classList.add('bg-white', 'text-[#6B5B4F]');
        }
      });

      const rows = card ? card.querySelectorAll<HTMLElement>('.ingredient-row') : [];
      rows.forEach((row) => {
        const volumePart = row.querySelector<HTMLElement>('.volume-unit-part');
        const metricPart = row.querySelector<HTMLElement>('.metric-unit-part');

        if (pref === 'metric') {
          if (volumePart) volumePart.style.display = 'none';
          if (metricPart) metricPart.style.display = 'inline-block';
        } else if (pref === 'volume') {
          if (volumePart) volumePart.style.display = 'inline';
          if (metricPart) metricPart.style.display = 'none';
        } else {
          // Dual view (default)
          if (volumePart) volumePart.style.display = 'inline';
          if (metricPart) metricPart.style.display = 'inline-block';
        }
      });

      try {
        localStorage.setItem(STORAGE_KEY, pref);
      } catch (e) {
        // Fallback if localStorage unavailable
      }
    }

    const savedPref = (() => {
      try {
        const p = localStorage.getItem(STORAGE_KEY) || 'dual';
        return (p === 'metric' || p === 'volume') ? p : 'dual';
      } catch {
        return 'dual';
      }
    })();
    applyUnitPreference(savedPref);

    unitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pref = btn.dataset.pref || 'dual';
        applyUnitPreference(pref);
      });
    });

    // Dedicated Baker's % Toggle (Strictly OFF by default)
    const bakersToggle = document.getElementById('bakers-pct-toggle') as HTMLButtonElement | null;
    let bakersPctActive = false;

    function setBakersPctState(active: boolean) {
      bakersPctActive = active;
      if (bakersToggle) {
        bakersToggle.setAttribute('aria-pressed', active ? 'true' : 'false');
        if (active) {
          bakersToggle.classList.add('bg-amber-100', 'text-amber-900', 'border-amber-400');
          bakersToggle.classList.remove('bg-white', 'text-[#6B5B4F]', 'border-[#EBE5D9]');
        } else {
          bakersToggle.classList.remove('bg-amber-100', 'text-amber-900', 'border-amber-400');
          bakersToggle.classList.add('bg-white', 'text-[#6B5B4F]', 'border-[#EBE5D9]');
        }
      }

      const bakersParts = card ? card.querySelectorAll<HTMLElement>('.bakers-unit-part') : [];
      bakersParts.forEach((part) => {
        part.style.display = active ? 'inline-block' : 'none';
      });
    }

    bakersToggle?.addEventListener('click', () => {
      setBakersPctState(!bakersPctActive);
    });

    // Serving / Batch Scaler
    const displayServings = document.getElementById('display-servings');
    const originalServings = Number(displayServings?.dataset.original || 4);
    const scaleBtns = card.querySelectorAll<HTMLButtonElement>('.scale-btn');
    const amountElements = card.querySelectorAll<HTMLElement>('.ingredient-amount');
    const metricElements = card.querySelectorAll<HTMLElement>('.metric-amount');

    function formatAmount(val: number): string {
      const rounded = Math.round(val * 100) / 100;
      return rounded.toString();
    }

    scaleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const multiplier = parseFloat(btn.dataset.multiplier || '1');

        // Update button styles and aria-pressed
        scaleBtns.forEach((b) => {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          b.classList.remove('bg-[#9C4B25]', 'text-white');
          b.classList.add('bg-white', 'text-[#9C4B25]');
        });
        btn.classList.add('bg-[#9C4B25]', 'text-white');
        btn.classList.remove('bg-white', 'text-[#9C4B25]');

        // Update servings display with proper rounding
        if (displayServings) {
          const scaledServings = Math.round(originalServings * multiplier * 10) / 10;
          displayServings.textContent = scaledServings.toString();
        }

        // Show/hide baking pan warning
        if (bakingWarning) {
          if (isBaking && multiplier >= 2) {
            bakingWarning.classList.remove('hidden');
            bakingWarning.classList.add('flex');
          } else {
            bakingWarning.classList.add('hidden');
            bakingWarning.classList.remove('flex');
          }
        }

        // Recalculate volume amounts
        amountElements.forEach((el) => {
          const base = el.dataset.base;
          if (base && !isNaN(Number(base))) {
            const calculated = Number(base) * multiplier;
            el.textContent = formatAmount(calculated);
          }
        });

        // Recalculate metric weight amounts
        metricElements.forEach((el) => {
          const base = el.dataset.base;
          if (base && !isNaN(Number(base))) {
            const calculated = Number(base) * multiplier;
            el.textContent = formatAmount(calculated);
          }
        });
      });
    });

    // Mise-en-place Preparation Progress Tracker
    const checkboxes = card.querySelectorAll<HTMLInputElement>('.ingredient-row input[type="checkbox"]');
    const progressText = document.getElementById('prep-progress-text');
    const progressBar = document.getElementById('prep-progress-bar');

    function updateProgress() {
      const total = checkboxes.length;
      if (total === 0) return;
      let checked = 0;
      checkboxes.forEach((cb) => {
        if (cb.checked) checked++;
      });
      const pct = Math.round((checked / total) * 100);
      if (progressText) {
        progressText.textContent = `${checked} of ${total} prepped (${pct}%)`;
      }
      if (progressBar) {
        progressBar.style.width = `${pct}%`;
      }
    }
    updateProgress();

    // Checkbox strikethrough interaction
    const rows = card.querySelectorAll<HTMLElement>('.ingredient-row');
    rows.forEach((row) => {
      const checkbox = row.querySelector<HTMLInputElement>('input[type="checkbox"]');
      const text = row.querySelector<HTMLElement>('.ingredient-text');

      row.addEventListener('click', (e) => {
        if (e.target !== checkbox && checkbox) {
          checkbox.checked = !checkbox.checked;
        }
        if (checkbox?.checked) {
          text?.classList.add('line-through', 'opacity-40');
        } else {
          text?.classList.remove('line-through', 'opacity-40');
        }
        updateProgress();
      });
    });
  }

  setupIngredients();
  document.addEventListener('astro:page-load', setupIngredients);
</script>
