---
import GroceryExporter from './GroceryExporter.astro';

export interface IngredientItem {
  name: string;
  amount?: number | string;
  unit?: string;
  metricAmount?: number | string;
  metricUnit?: string;
  notes?: string;
  optional?: boolean;
  boosterEffect?: string;
  bakersPercentage?: number;
}

export interface IngredientGroup {
  category?: string;
  groupTitle?: string;
  items: IngredientItem[];
}

export interface Props {
  ingredients: IngredientGroup[];
  servings: number;
  recipeTitle?: string;
  isBaking?: boolean;
  bakerFlourWeight?: number;
}

const { ingredients, servings, recipeTitle = 'Recipe', isBaking = false, bakerFlourWeight } = Astro.props;

// Calculate base flour weight for Baker's Percentages if baking
const calculatedFlourWeight = (() => {
  if (bakerFlourWeight && bakerFlourWeight > 0) return bakerFlourWeight;
  let total = 0;
  for (const group of ingredients) {
    for (const item of group.items) {
      const lower = item.name.toLowerCase();
      if ((lower.includes('flour') || lower.includes('maida') || lower.includes('atta')) && typeof item.metricAmount === 'number' && !item.optional) {
        total += item.metricAmount;
      }
    }
  }
  return total > 0 ? total : 0;
})();
---

<div class="bg-white rounded-3xl border border-[#EBE5D9] p-6 sm:p-8 shadow-xs" id="ingredient-card" data-is-baking={isBaking ? 'true' : 'false'}>
  <!-- Header & Serving Scaler & Unit Preferences -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-6 border-b border-[#EBE5D9] gap-4">
    <div>
      <h2 class="text-2xl font-serif font-bold text-[#4A3F35]">Ingredients</h2>
      <p class="text-xs text-[#6B5B4F] mt-0.5">Click ingredients to cross them off. Dual weight & volume provided.</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Unit Preference Toggle (Persists to localStorage) -->
      <div class="flex items-center gap-1 bg-[#FAF3EE] p-1 rounded-2xl border border-[#EBE5D9] flex-wrap">
        <button 
          type="button" 
          class="unit-pref-btn text-xs font-bold py-1.5 px-3 rounded-xl transition-all bg-[#9C4B25] text-white cursor-pointer" 
          data-pref="dual" 
          aria-label="Show dual units (cups and grams)"
        >
          Dual
        </button>
        <button 
          type="button" 
          class="unit-pref-btn text-xs font-bold py-1.5 px-3 rounded-xl transition-all bg-white text-[#6B5B4F] hover:text-[#9C4B25] cursor-pointer" 
          data-pref="metric" 
          aria-label="Show metric weight in grams"
        >
          Grams (g)
        </button>
        <button 
          type="button" 
          class="unit-pref-btn text-xs font-bold py-1.5 px-3 rounded-xl transition-all bg-white text-[#6B5B4F] hover:text-[#9C4B25] cursor-pointer" 
          data-pref="volume" 
          aria-label="Show volume in cups and spoons"
        >
          Cups
        </button>
        {isBaking && (
          <button 
            type="button" 
            class="unit-pref-btn text-xs font-bold py-1.5 px-3 rounded-xl transition-all bg-white text-[#6B5B4F] hover:text-[#9C4B25] cursor-pointer" 
            data-pref="bakers" 
            aria-label="Show Baker's percentages relative to flour"
          >
            Baker's %
          </button>
        )}
      </div>

      <!-- Scaler Control (Whole-batch scaling for Baking) -->
      <div class="flex items-center gap-2 bg-[#FAF3EE] p-1.5 rounded-2xl border border-[#EBE5D9]">
        <span class="text-xs font-semibold text-[#6B5B4F] px-2 flex items-center gap-1">
          <span>{isBaking ? 'Yield:' : 'Servings:'}</span>
          <strong id="display-servings" class="text-[#9C4B25]" data-original={servings}>{servings}</strong>
        </span>
        <div class="flex items-center gap-1">
          <button type="button" class="scale-btn min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-bold py-2 px-3 rounded-xl transition-all bg-white text-[#9C4B25] shadow-xs hover:bg-[#9C4B25] hover:text-white cursor-pointer" data-multiplier="0.5" aria-label="Scale ingredients to half servings">0.5x</button>
          <button type="button" class="scale-btn min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-bold py-2 px-3 rounded-xl transition-all bg-[#9C4B25] text-white shadow-xs cursor-pointer" data-multiplier="1" aria-label="Scale ingredients to 1x original servings">1x</button>
          <button type="button" class="scale-btn min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-bold py-2 px-3 rounded-xl transition-all bg-white text-[#9C4B25] shadow-xs hover:bg-[#9C4B25] hover:text-white cursor-pointer" data-multiplier="2" aria-label="Scale ingredients to double servings">2x</button>
          {!isBaking && (
            <button type="button" class="scale-btn min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-bold py-2 px-3 rounded-xl transition-all bg-white text-[#9C4B25] shadow-xs hover:bg-[#9C4B25] hover:text-white cursor-pointer" data-multiplier="3" aria-label="Scale ingredients to triple servings">3x</button>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Baking Multiplier Warning Banner -->
  <div id="baking-scale-warning" class="hidden mt-4 p-3.5 bg-amber-50 border border-amber-200 rounded-2xl text-xs text-amber-900 items-center gap-2.5">
    <span class="text-base">⚠️</span>
    <span><strong>Baking Vessel Warning:</strong> When doubling (2x), divide the dough across 2 skillets or loaf tins; do not crowd into a single pan.</span>
  </div>

  <!-- Ingredients by Category / Group -->
  <div class="mt-6 space-y-6">
    {ingredients.map((group) => {
      const title = group.groupTitle || group.category;
      return (
        <div>
          {title && title !== 'Ingredients' && (
            <h3 class="text-sm font-bold uppercase tracking-wider text-[#9C4B25] mb-3 flex items-center gap-1.5">
              <span>🥖</span>
              <span>{title}</span>
            </h3>
          )}
          <ul class="space-y-3">
            {group.items.map((item) => {
              const hasNumericAmount = typeof item.amount === 'number';
              const hasNumericMetric = typeof item.metricAmount === 'number';

              // Calculate Baker's percentage if applicable
              let computedBakersPct: number | null = null;
              if (typeof item.bakersPercentage === 'number') {
                computedBakersPct = item.bakersPercentage;
              } else if (calculatedFlourWeight > 0 && hasNumericMetric) {
                computedBakersPct = Math.round(((item.metricAmount as number) / calculatedFlourWeight) * 100);
              }

              return (
                <li class={`ingredient-row flex items-start gap-3 p-2.5 rounded-xl transition-colors cursor-pointer select-none group ${item.optional ? 'bg-amber-50/50 hover:bg-amber-50 border border-amber-100/70' : 'hover:bg-[#FAF3EE]/60'}`}>
                  <input 
                    type="checkbox" 
                    class="mt-1 h-4 w-4 rounded border-[#D5CDC1] text-[#9C4B25] focus:ring-[#9C4B25] cursor-pointer shrink-0"
                    aria-label={`Mark ${item.name} as prepared`}
                  />
                  <div class="flex-1">
                    <span class="ingredient-text text-sm sm:text-base text-[#4A3F35] leading-relaxed block">
                      {item.amount !== undefined && (
                        <span class="volume-unit-part">
                          <strong 
                            class="font-semibold text-[#9C4B25] ingredient-amount" 
                            data-base={hasNumericAmount ? item.amount : ''}
                          >
                            {item.amount}
                          </strong>
                          {item.unit && <span class="font-medium text-[#4A3F35]"> {item.unit}</span>}
                        </span>
                      )}

                      {item.metricAmount !== undefined && (
                        <span class="metric-unit-part text-xs font-semibold text-[#6B5B4F] bg-[#FAF3EE] px-2 py-0.5 rounded-lg border border-[#EBE5D9] mx-1.5 inline-block">
                          <span class="metric-amount" data-base={hasNumericMetric ? item.metricAmount : ''}>
                            {item.metricAmount}
                          </span>
                          {item.metricUnit && <span> {item.metricUnit}</span>}
                        </span>
                      )}

                      {computedBakersPct !== null && (
                        <span class="bakers-unit-part hidden text-xs font-bold text-amber-900 bg-amber-100/80 px-2 py-0.5 rounded-lg border border-amber-200 mx-1.5 inline-block">
                          <span>{computedBakersPct}% Baker's</span>
                        </span>
                      )}

                      <span class="font-medium"> {item.name}</span>
                      {item.notes && <span class="text-xs text-[#6B5B4F] italic block sm:inline sm:ml-1">({item.notes})</span>}
                    </span>

                    {item.optional && (
                      <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                        <span class="text-[10px] font-bold uppercase tracking-wider bg-amber-200/70 text-amber-900 border border-amber-300 px-2 py-0.5 rounded-md inline-flex items-center gap-1">
                          <span>✨</span>
                          <span>Optional Booster</span>
                        </span>
                        {item.boosterEffect && (
                          <span class="text-xs text-[#6B5B4F] italic bg-[#FAF3EE] px-2 py-0.5 rounded-md border border-[#EBE5D9]">
                            {item.boosterEffect}
                          </span>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </div>

  <GroceryExporter recipeTitle={recipeTitle} />
</div>

<script>
  function setupIngredients() {
    const card = document.getElementById('ingredient-card');
    if (!card || card.dataset.initialized === 'true') return;
    card.dataset.initialized = 'true';

    const isBaking = card.dataset.isBaking === 'true';
    const bakingWarning = document.getElementById('baking-scale-warning');

    // Unit Preference Persistence
    const STORAGE_KEY = 'cozy_unit_pref';
    const unitBtns = card.querySelectorAll<HTMLButtonElement>('.unit-pref-btn');

    function applyUnitPreference(pref: string) {
      unitBtns.forEach((btn) => {
        if (btn.dataset.pref === pref) {
          btn.classList.add('bg-[#9C4B25]', 'text-white');
          btn.classList.remove('bg-white', 'text-[#6B5B4F]');
        } else {
          btn.classList.remove('bg-[#9C4B25]', 'text-white');
          btn.classList.add('bg-white', 'text-[#6B5B4F]');
        }
      });

      const rows = card ? card.querySelectorAll<HTMLElement>('.ingredient-row') : [];
      rows.forEach((row) => {
        const volumePart = row.querySelector<HTMLElement>('.volume-unit-part');
        const metricPart = row.querySelector<HTMLElement>('.metric-unit-part');
        const bakersPart = row.querySelector<HTMLElement>('.bakers-unit-part');

        if (pref === 'bakers') {
          if (volumePart) volumePart.classList.add('hidden');
          if (metricPart) metricPart.classList.add('hidden');
          if (bakersPart) bakersPart.classList.remove('hidden');
        } else if (pref === 'metric') {
          if (volumePart) volumePart.classList.add('hidden');
          if (metricPart) metricPart.classList.remove('hidden');
          if (bakersPart) bakersPart.classList.add('hidden');
        } else if (pref === 'volume') {
          if (volumePart) volumePart.classList.remove('hidden');
          if (metricPart) metricPart.classList.add('hidden');
          if (bakersPart) bakersPart.classList.add('hidden');
        } else {
          // Dual view (default)
          if (volumePart) volumePart.classList.remove('hidden');
          if (metricPart) metricPart.classList.remove('hidden');
          if (bakersPart) bakersPart.classList.add('hidden');
        }
      });

      try {
        localStorage.setItem(STORAGE_KEY, pref);
      } catch (e) {
        // Fallback if localStorage unavailable
      }
    }

    const savedPref = (() => {
      try {
        const p = localStorage.getItem(STORAGE_KEY) || 'dual';
        return (!isBaking && p === 'bakers') ? 'dual' : p;
      } catch {
        return 'dual';
      }
    })();
    applyUnitPreference(savedPref);

    unitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pref = btn.dataset.pref || 'dual';
        applyUnitPreference(pref);
      });
    });

    // Serving / Batch Scaler
    const displayServings = document.getElementById('display-servings');
    const originalServings = Number(displayServings?.dataset.original || 4);
    const scaleBtns = card.querySelectorAll<HTMLButtonElement>('.scale-btn');
    const amountElements = card.querySelectorAll<HTMLElement>('.ingredient-amount');
    const metricElements = card.querySelectorAll<HTMLElement>('.metric-amount');

    function formatAmount(val: number): string {
      const rounded = Math.round(val * 100) / 100;
      return rounded.toString();
    }

    scaleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const multiplier = parseFloat(btn.dataset.multiplier || '1');

        // Update button styles
        scaleBtns.forEach((b) => {
          b.classList.remove('bg-[#9C4B25]', 'text-white');
          b.classList.add('bg-white', 'text-[#9C4B25]');
        });
        btn.classList.add('bg-[#9C4B25]', 'text-white');
        btn.classList.remove('bg-white', 'text-[#9C4B25]');

        // Update servings display with proper rounding
        if (displayServings) {
          const scaledServings = Math.round(originalServings * multiplier * 10) / 10;
          displayServings.textContent = scaledServings.toString();
        }

        // Show/hide baking pan warning
        if (bakingWarning) {
          if (isBaking && multiplier >= 2) {
            bakingWarning.classList.remove('hidden');
            bakingWarning.classList.add('flex');
          } else {
            bakingWarning.classList.add('hidden');
            bakingWarning.classList.remove('flex');
          }
        }

        // Recalculate volume amounts
        amountElements.forEach((el) => {
          const base = el.dataset.base;
          if (base && !isNaN(Number(base))) {
            const calculated = Number(base) * multiplier;
            el.textContent = formatAmount(calculated);
          }
        });

        // Recalculate metric weight amounts
        metricElements.forEach((el) => {
          const base = el.dataset.base;
          if (base && !isNaN(Number(base))) {
            const calculated = Number(base) * multiplier;
            el.textContent = formatAmount(calculated);
          }
        });
      });
    });

    // Checkbox strikethrough interaction
    const rows = card.querySelectorAll<HTMLElement>('.ingredient-row');
    rows.forEach((row) => {
      const checkbox = row.querySelector<HTMLInputElement>('input[type="checkbox"]');
      const text = row.querySelector<HTMLElement>('.ingredient-text');

      row.addEventListener('click', (e) => {
        if (e.target !== checkbox && checkbox) {
          checkbox.checked = !checkbox.checked;
        }
        if (checkbox?.checked) {
          text?.classList.add('line-through', 'opacity-40');
        } else {
          text?.classList.remove('line-through', 'opacity-40');
        }
      });
    });
  }

  setupIngredients();
  document.addEventListener('astro:page-load', setupIngredients);
</script>
