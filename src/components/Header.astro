---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const isActive = (path: string) => path === '/' ? pathname === '/' : pathname.startsWith(path);
---

<header class="bg-white/90 backdrop-blur-md border-b border-[#EBE5D9] sticky top-0 z-40 transition-shadow">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4">
    <!-- Brand Logo & Name -->
    <a href="/" class="group flex items-center hover:opacity-95 transition-opacity">
      <Logo size="md" showWordmark={true} showTagline={true} />
    </a>

    <!-- Navigation links -->
    <nav class="flex items-center gap-1 sm:gap-4 md:gap-6 shrink-0" aria-label="Main navigation">
      <a 
        href="/" 
        class={`text-xs sm:text-sm font-medium transition-colors px-2 sm:px-2.5 py-1.5 rounded-lg ${isActive('/') ? 'text-[#9C4B25] font-semibold bg-[#FAF3EE]' : 'text-[#6B5B4F] hover:text-[#9C4B25]'}`}
      >
        Recipes
      </a>
      <a 
        href="/baking/" 
        class={`text-xs sm:text-sm font-medium transition-colors px-2 sm:px-2.5 py-1.5 rounded-lg flex items-center gap-1 ${isActive('/baking') ? 'text-[#9C4B25] font-semibold bg-[#FAF3EE]' : 'text-[#6B5B4F] hover:text-[#9C4B25]'}`}
      >
        <span aria-hidden="true">🥖</span>
        <span>Baking<span class="hidden sm:inline"> Hub</span></span>
      </a>
      <a 
        href="/categories/" 
        class={`text-xs sm:text-sm font-medium transition-colors px-2.5 py-1.5 rounded-lg hidden md:inline-block ${isActive('/categories') ? 'text-[#9C4B25] font-semibold bg-[#FAF3EE]' : 'text-[#6B5B4F] hover:text-[#9C4B25]'}`}
      >
        Categories
      </a>
      <a 
        href="/about/" 
        class={`text-xs sm:text-sm font-medium transition-colors px-2.5 py-1.5 rounded-lg hidden md:inline-block ${isActive('/about') ? 'text-[#9C4B25] font-semibold bg-[#FAF3EE]' : 'text-[#6B5B4F] hover:text-[#9C4B25]'}`}
      >
        About
      </a>
      <a 
        href="/search/" 
        class={`flex items-center gap-1.5 text-xs sm:text-sm font-medium px-2.5 sm:px-3 py-1.5 rounded-xl border border-[#EBE5D9] transition-all ${isActive('/search') ? 'bg-[#9C4B25] text-white border-[#9C4B25]' : 'bg-[#FDFBF7] text-[#4A3F35] hover:border-[#9C4B25] hover:text-[#9C4B25]'}`}
        aria-label="Search recipes"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <span class="hidden sm:inline">Search</span>
      </a>
    </nav>
  </div>
</header>
