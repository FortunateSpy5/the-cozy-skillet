---
export interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showWordmark?: boolean;
  showTagline?: boolean;
  class?: string;
}

const {
  size = 'md',
  showWordmark = true,
  showTagline = false,
  class: className = '',
} = Astro.props;

// Size configurations
const iconSizes = {
  sm: 'w-6 h-6',
  md: 'w-8 h-8',
  lg: 'w-10 h-10',
  xl: 'w-16 h-16',
};

const badgeSizes = {
  sm: 'w-8 h-8 rounded-xl p-1',
  md: 'w-11 h-11 rounded-2xl p-1.5 shadow-2xs',
  lg: 'w-14 h-14 rounded-2xl p-2 shadow-xs',
  xl: 'w-24 h-24 rounded-3xl p-3 shadow-sm',
};

const wordmarkSizes = {
  sm: 'text-base',
  md: 'text-xl',
  lg: 'text-2xl',
  xl: 'text-3xl',
};
---

<div class={`inline-flex items-center gap-3 ${className}`}>
  <!-- Logo Icon Container (Warm Cream Tile with subtle border) -->
  <div class={`${badgeSizes[size]} bg-white border border-[#EBE5D9] flex items-center justify-center shrink-0`}>
    <svg 
      class={`${iconSizes[size]} shrink-0`} 
      viewBox="0 0 68 64" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Steam Plumes -->
      <path d="M23 21C23 15 27 12 27 6" stroke="#D87D4A" stroke-width="3.2" stroke-linecap="round"/>
      <path d="M35 19C35 13 39.5 10 39.5 4" stroke="#D87D4A" stroke-width="3" stroke-linecap="round"/>
      
      <!-- Sizzle Butter Bubbles & Aroma Sparks -->
      <circle cx="16" cy="18" r="2.2" fill="#E5A93C"/>
      <circle cx="19" cy="11" r="1.3" fill="#D87D4A"/>
      <circle cx="44" cy="16" r="2" fill="#E5A93C"/>
      <circle cx="46" cy="10" r="1.2" fill="#E5A93C"/>
      
      <!-- Left Helper Tab (Seamless Molded Cast Iron) -->
      <path d="M8 33.5C5.2 33.5 4 35 4 37.2C4 39.5 5.2 41 8.5 41V33.5H8Z" fill="#7A3617"/>
      <path d="M8 35.5C6 35.5 5.2 36.3 5.2 37.2C5.2 38.2 6 39 8 39V35.5Z" fill="#9C4B25"/>
      
      <!-- Heavy Skillet Body -->
      <path d="M8.5 35C8.5 46.5 16 55.5 28 55.5H32C44 55.5 51.5 46.5 51.5 35H8.5Z" fill="#9C4B25"/>
      
      <!-- Cast Iron Outer Rim (Perspective Ellipse) -->
      <ellipse cx="30" cy="34" rx="22" ry="3.5" fill="#7A3617"/>
      
      <!-- Molten Saffron Butter Pool Interior -->
      <ellipse cx="30" cy="34.2" rx="19" ry="2.2" fill="#D87D4A"/>
      <ellipse cx="30" cy="34.6" rx="15" ry="1.4" fill="#E5A93C"/>
      
      <!-- Ergonomic Cast Iron Handle -->
      <path d="M51.5 33.5C53 33.2 55 32 57.5 30C59.5 28.5 62 28 64.5 29C66.3 29.8 66.8 31.5 66 33C65 35 62.5 36.5 57.5 37.2C55 37.5 53 37 51.5 36.5V33.5Z" fill="#9C4B25"/>
      <!-- Hanging Loop -->
      <circle cx="63" cy="31" r="1.5" fill="#FDFBF7"/>
      
      <!-- Pan Belly Reflection (Left Volume) -->
      <path d="M13 39C13 45.5 18 50.5 26 51.5" stroke="white" stroke-width="2.2" stroke-linecap="round" opacity="0.32"/>
      
      <!-- Handle Spine Ridge Highlight -->
      <path d="M53.5 33.2C55.5 31.8 58 30.2 61 29.4" stroke="white" stroke-width="1.4" stroke-linecap="round" opacity="0.45"/>
    </svg>
  </div>

  <!-- Optional Wordmark & Tagline -->
  {showWordmark && (
    <div class="leading-none">
      <span class={`block font-serif font-bold text-[#4A3F35] tracking-tight ${wordmarkSizes[size]}`}>
        The Cozy Skillet
      </span>
      {showTagline && (
        <span class="block text-[10px] font-sans font-semibold uppercase tracking-wider text-[#9C4B25] mt-1">
          No-Fluff Digital Cookbook
        </span>
      )}
    </div>
  )}
</div>
